# Copy this file to ".env" and fill in ONE provider. .env is git-ignored: never commit API keys.

# --- Default: built-in test model (no key, no cost) ---
LLM_MODE=mock

# --- Option A: Google Gemini (free tier, key from https://aistudio.google.com) ---
# LLM_MODE=api
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-3.8-flash

# --- Option B: Groq (free tier, key from https://console.groq.com) ---
# LLM_MODE=api
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=openai/gpt-oss-120b

# --- Option C: Ollama on your own computer (https://ollama.com, then: ollama pull llama3.1) ---
# LLM_MODE=api
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

PROXY_MODE=MONITOR
CANARY_TOKEN=CANARY-7f3a9c2e-INTERNAL-KEY
DB_PATH=logs/proxy.db
# REPORT_AUTHOR=Your Name
